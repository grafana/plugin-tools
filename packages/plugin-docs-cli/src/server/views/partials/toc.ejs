<p class="docs-rail-title">On this page</p>
<% if (!headings || headings.length === 0) { %>
  <p class="docs-rail-empty">No headings found</p>
<% } else { %>
  <ul class="docs-toc-list">
    <% headings.forEach((heading) => { %>
      <li>
        <a href="#<%= heading.id %>" class="docs-toc-link docs-toc-link-h<%= heading.level %>"><%= heading.text %></a>
      </li>
    <% }); %>
  </ul>
<% } %>
