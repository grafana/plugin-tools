<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= manifest.title %> (local preview)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/styles/docs.css">
</head>
<body>
  <div class="docs-page">
    <div class="docs-badge-row">
      <span class="docs-badge">Local preview</span>
    </div>

    <div class="docs-tabs-wrap">
      <nav class="docs-tabs" aria-label="Plugin tabs">
        <a href="/" class="docs-tab<%= activeTab === 'overview' ? ' active' : '' %>">Overview</a>
        <span class="docs-tab disabled" aria-disabled="true">Installation</span>
        <span class="docs-tab disabled" aria-disabled="true">Change log</span>
        <% if (hasDocs) { %>
          <a href="/docs" class="docs-tab<%= activeTab === 'documentation' ? ' active' : '' %>">Documentation</a>
        <% } else { %>
          <span class="docs-tab disabled" aria-disabled="true">Documentation</span>
        <% } %>
      </nav>
    </div>

    <% if (activeTab === 'documentation' && docsNav) { %>
      <details class="docs-mobile-nav">
        <summary>Documentation pages</summary>
        <%- include('partials/navigation', { items: docsNav }) %>
      </details>
    <% } %>

    <div class="docs-grid">
      <main class="docs-content plugin-content" id="plugin-tab-content">
        <% if (activeTab === 'documentation') { %>
          <% if (breadcrumb && breadcrumb.length > 0) { %>
            <nav class="docs-breadcrumb" aria-label="Breadcrumb">
              <ol>
                <% breadcrumb.forEach((crumb, index) => { %>
                  <li>
                    <% if (crumb.href) { %>
                      <a href="<%= crumb.href %>"><%= crumb.label %></a>
                    <% } else { %>
                      <span aria-current="page"><%= crumb.label %></span>
                    <% } %>
                    <% if (index < breadcrumb.length - 1) { %><span class="docs-breadcrumb-sep" aria-hidden="true">/</span><% } %>
                  </li>
                <% }); %>
              </ol>
            </nav>
          <% } %>
          <h1><%= pageTitle %></h1>
        <% } %>
        <%- content %>
      </main>

      <aside class="docs-rail" aria-label="Page navigation">
        <div class="docs-rail-sticky">
          <% if (activeTab === 'documentation' && docsNav) { %>
            <p class="docs-rail-title"><%= docsNavTitle %></p>
            <%- include('partials/navigation', { items: docsNav }) %>
          <% } else { %>
            <%- include('partials/toc', { headings: onThisPage }) %>
          <% } %>
        </div>
      </aside>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggles = document.querySelectorAll('.docs-nav-toggle');
      toggles.forEach((button) => {
        button.addEventListener('click', () => {
          const item = button.closest('.docs-nav-item');
          if (!item) return;
          const open = item.getAttribute('data-open') === 'true';
          item.setAttribute('data-open', String(!open));
          button.setAttribute('aria-expanded', String(!open));
        });
      });
    });
  </script>

  <% if (liveReload) { %>
  <script>
    let lastCheck = Date.now();
    setInterval(async () => {
      try {
        const res = await fetch('/__reload__?t=' + lastCheck);
        if (res.status === 205) {
          location.reload();
        }
        lastCheck = Date.now();
      } catch (e) {
        // ignore fetch errors
      }
    }, 1000);
  </script>
  <% } %>
</body>
</html>
