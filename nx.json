{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "nodeVersion", "sharedGlobals", "{workspaceRoot}/rollup.config.ts"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "^default", "{workspaceRoot}/eslint.config.mjs"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^default", "nodeVersion", "{workspaceRoot}/vitest.config.base.ts"],
      "cache": true
    }
  },
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/knip.json",
      "{workspaceRoot}/.nvmrc"
    ],
    "nodeVersion": [{ "runtime": "node -p \"process.versions.node.split('.').slice(0, 2).join('.')\"" }]
  },
  "defaultBase": "main",
  "nxCloudAccessToken": "ZDU3OTNkMTItNWIwZi00N2U4LTk2MjYtNzJkYzA0YzgwNWNlfHJlYWQ=",
  "tui": {
    "enabled": false
  },
  "analytics": false
}
